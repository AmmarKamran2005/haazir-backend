# ─────────────────────────────────────────────────────────────────────────────
# HAAZIR API — copy to api/.env and fill in. api/.env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# ── Neon ─────────────────────────────────────────────────────────────────────
# Two Postgres roles, on purpose. Neon's default role (hazir_owner) is a member of
# neon_superuser and carries BYPASSRLS, which outranks FORCE ROW LEVEL SECURITY
# and makes every policy inert. So the API never connects as it.
#
#   hazir_owner   owns the schema, runs migrations.        -> DATABASE_URL_DIRECT
#   haazir_app    what the API runs as. NOBYPASSRLS, DML   -> DATABASE_URL
#                 only. Created by migration 0012.
#
# Setup order for a fresh branch:
#   1. DATABASE_URL_DIRECT = the owner's DIRECT string from the Neon console
#      (host without "-pooler"). Paste it exactly, sslmode and all.
#   2. APP_DB_PASSWORD = python -c "import secrets; print(secrets.token_urlsafe(24))"
#   3. alembic upgrade head        (creates haazir_app with that password)
#   4. DATABASE_URL = the POOLED string (host with "-pooler"), with the userinfo
#      replaced by haazir_app:<APP_DB_PASSWORD>
DATABASE_URL=postgresql://haazir_app:APP_DB_PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/haazir?sslmode=require
DATABASE_URL_DIRECT=postgresql://hazir_owner:OWNER_PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/haazir?sslmode=require
APP_DB_PASSWORD=
DB_ECHO=false

# Background jobs run inside the API process (plan §11). Exactly ONE instance may have
# this on: two processes refreshing live_state every minute would double the compute
# bill on a hundred-hour-a-month plan.
RUN_SCHEDULER=true

# Blanket per-IP throttle on every write. Leave on in production.
RATE_LIMIT_ENABLED=true

# ── Tests ────────────────────────────────────────────────────────────────────
# The suite TRUNCATEs every table, so it reads these two keys and deliberately
# refuses to fall back to DATABASE_URL. Point them at a throwaway Neon branch
# (neon branches create --name test), migrated the same way as above.
# Leave them empty and the database tests skip with a visible reason.
TEST_DATABASE_URL=
TEST_DATABASE_URL_DIRECT=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Server only. Never prefix this with NEXT_PUBLIC_.
JWT_SECRET=
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=7776000
COOKIE_SECURE=true
# Comma separated. These addresses get the admin role on first login.
# Anyone signing in with one of these addresses gets the admin role, which is what
# issues staff device tokens and decides the enforcement review queue.
ADMIN_EMAILS=admin@haazir.pk

# ── Mail (Resend) ────────────────────────────────────────────────────────────
# Without a key, magic links are logged to the console instead of sent, so the
# whole auth flow is still testable locally.
RESEND_API_KEY=
MAIL_FROM=HAAZIR <login@haazir.pk>
WEB_BASE_URL=http://localhost:3000

# ── LLM (Phase 8) ────────────────────────────────────────────────────────────
# The LLM provider. Explanations and the intent fallback both use Gemini;
# with this unset the product runs on templates and the parser, which is the
# designed default rather than a degraded mode.
GEMINI_API_KEY=

LLM_MONTHLY_CEILING_USD=25

# ── Routing (Phase 4) ────────────────────────────────────────────────────────
OSRM_URL=
MAPBOX_TOKEN=

# ── Storage (Phase 5) ────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
